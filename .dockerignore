# Build-Kontext klein halten
.git
.github
.gitignore

# Python
__pycache__
*.pyc
.pytest_cache
.venv
venv

# Sensible/lokale Dateien (Secrets kommen per env/Volume in den Container)
.env
data

# Frontend: node_modules und dist werden im Build-Stage frisch erzeugt
frontend/node_modules
frontend/dist
frontend/.vite

# Doku/Grosse Dateien, die das Image nicht braucht
Synology_File_Station_API_Guide.pdf
*.md
test_*.py

# Docker selbst
Dockerfile
docker-compose.yml
.dockerignore
