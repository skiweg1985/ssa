# Synology NAS Zugangsdaten
# Diese Datei enthält sensible Informationen und sollte nicht in Git committed werden
# Kopiere diese Datei zu .env und trage deine Zugangsdaten ein

# ==============================================================================
# FASTAPI-SERVER: AUTHENTIFIZIERUNG & SICHERHEIT
# ==============================================================================

# PFLICHT für den Server: Passwort für den Web-Login (Benutzer: admin).
# Ohne gesetztes Passwort ist der Login deaktiviert (fail-closed).
SSA_ADMIN_PASSWORD=bitte-aendern

# Optional: anderer Benutzername für den Web-Login (Default: admin)
#SSA_ADMIN_USER=admin

# Optional: Secret-Key für Token-Signierung und Verschlüsselung der
# NAS-Passwörter in der Datenbank. Ohne Angabe wird beim ersten Start
# automatisch data/secret.key erzeugt (überlebt Neustarts).
# ACHTUNG: Wird der Key geändert/gelöscht, müssen alle NAS-Passwörter
# im Frontend neu eingegeben werden.
#SSA_SECRET_KEY=langer-zufaelliger-string

# Optional: Token-Lebensdauer in Stunden (Default: 168 = 7 Tage)
#SSA_TOKEN_TTL_HOURS=168

# Optional: Erlaubte CORS-Origins, kommasepariert
# (nur für getrenntes Frontend-Hosting nötig; Default: Vite-Dev-Server)
#SSA_CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# ERFORDERLICHE ZUGANGSDATEN
# ==============================================================================

# Hostname oder IP-Adresse des Synology NAS
# Unterstützte Variablennamen: SYNO_HOST, SYNO_NAS_HOST, NAS_IP
SYNO_HOST=192.168.1.100

# Benutzername für die API-Anmeldung
# Unterstützte Variablennamen: SYNO_USERNAME, SYNO_USER, SYNO_ACCOUNT
SYNO_USERNAME=admin

# Passwort für die API-Anmeldung
# Unterstützte Variablennamen: SYNO_PASSWORD, SYNO_PW, SYNO_PASSWD
SYNO_PASSWORD=your_password_here

# ==============================================================================
# OPTIONALE KONFIGURATION
# ==============================================================================

# Maximale Anzahl gleichzeitig laufender Tasks (Standard: 3)
# Gültige Werte: 1-10
SYNO_MAX_PARALLEL_TASKS=3

# Standard-Ausführungsmodus (Standard: parallel)
# Gültige Werte: parallel, sequential
SYNO_DEFAULT_EXECUTION_MODE=parallel

# ==============================================================================
# SSL/TLS KONFIGURATION
# ==============================================================================

# SSL-Zertifikat-Verifizierung aktivieren/deaktivieren
# Standard: true (sicher) - SSL-Verifizierung ist aktiviert
# Setze auf false, wenn du selbst-signierte Zertifikate verwendest
# Unterstützte Werte: true, false, 1, 0, yes, no, on, off
SYNO_VERIFY_SSL=true

# Alternative: SSL-Verifizierung deaktivieren (insecure mode)
# Wenn SYNO_VERIFY_SSL gesetzt ist, wird diese Variable ignoriert
# Setze auf true, um SSL-Verifizierung zu deaktivieren
# Unterstützte Werte: true, false, 1, 0, yes, no, on, off
# SYNO_INSECURE=false

# ==============================================================================
# HINWEISE
# ==============================================================================
# 
# - Die SSL-Verifizierung kann auch über das CLI-Flag --insecure deaktiviert werden
# - CLI-Flags haben höchste Priorität und überschreiben Umgebungsvariablen
# - Für selbst-signierte Zertifikate: Setze SYNO_VERIFY_SSL=false oder verwende --insecure
# - Die Datei .env ist bereits in .gitignore und wird nicht committed

# ==============================================================================
# LOGGING KONFIGURATION
# ==============================================================================

# Logging-Level aktivieren/deaktivieren (Standard: deaktiviert)
# Standard: Logging ist deaktiviert (nur WARNING und höher werden angezeigt)
# Setze auf true, 1, yes, on oder info, um INFO-Level-Logs zu aktivieren
# Setze auf debug oder verbose, um DEBUG-Level-Logs zu aktivieren
# Setze auf warning oder warn, um nur WARNING-Level-Logs anzuzeigen
# Setze auf error oder critical, um nur ERROR-Level-Logs anzuzeigen
# Unterstützte Werte: true, false, 1, 0, yes, no, on, off, info, debug, verbose, warning, warn, error, critical
# SYNO_ENABLE_LOGS=false
